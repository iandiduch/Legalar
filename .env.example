# === App ===
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]


# Habilitar/deshabilitar Swagger UI (/docs), ReDoc (/redoc) y OpenAPI (/api/v1/openapi.json).
# Por defecto: habilitado en 'local' y 'docker', deshabilitado en 'production'.
# Dejar vacio para el comportamiento automatico, o forzar con true/false.
DOCS_ENABLED=

# === Modelos de Lenguaje (OpenRouter / OpenAI) ===
# Soporta tanto modelos gratuitos de OpenRouter como modelos de pago (OpenAI, Anthropic, DeepSeek).
#
# PERFIL 1: OPENROUTER GRATUITO
# OPENAI_API_KEY=sk-or-v1-tu-clave-gratuita-de-openrouter
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENAI_VISION_MODEL=google/gemini-2.0-flash-exp:free
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
#
# PERFIL 2: OPENROUTER PRODUCTIVO / DE PAGO
# OPENAI_API_KEY=sk-or-v1-tu-clave-de-pago
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=openai/gpt-4o-mini
# OPENAI_VISION_MODEL=openai/gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
#
# PERFIL 3: OPENAI DIRECTO
# OPENAI_API_KEY=sk-proj-tu-clave-openai-oficial
# OPENAI_BASE_URL=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OPENAI_API_KEY=sk-or-v1-tu-clave-aqui
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_CHAT_MODEL=openai/gpt-4o-mini
OPENAI_VISION_MODEL=google/gemini-2.0-flash-exp:free
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
LLM_TEMPERATURE=0.0
MAX_FILE_UPLOAD_SIZE=10485760

# === Pinecone ===
PINECONE_API_KEY=pcsk-tu_clave_pinecone_aqui
PINECONE_INDEX_NAME=intelligence-system
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_UPSERT_BATCH_SIZE=100

# === Postgres ===
# En docker-compose usar POSTGRES_HOST=postgres; corriendo local sin Docker usar localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intelligence_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
CHECKPOINTER_POOL_MIN_SIZE=1
CHECKPOINTER_POOL_MAX_SIZE=10

# === Redis ===
# En docker-compose usar REDIS_HOST=redis; corriendo local sin Docker usar localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_INGEST_QUEUE_KEY=ingestion:jobs

# === Ingesta ===
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
UPLOAD_DIR=data/uploads
INGESTION_JOB_TIMEOUT_MINUTES=15
INGESTION_MAX_RETRIES=3
# Escanea el texto extraido de cada documento en busca de patrones de prompt
# injection antes de indexarlo (defensa en profundidad, no reemplaza el
# hardening de los prompts ni el scope admin de /ingest -- ver README 3.5).
INGESTION_CONTENT_SCAN_ENABLED=true

# === Agentes / grafo ===
MAX_SUPERVISOR_ITERATIONS=6
GRAPH_RECURSION_LIMIT=25
STRUCTURED_OUTPUT_MAX_ATTEMPTS=3

# === Legalize / Legislación Argentina ===
LEGALIZE_REPO_PATH=repo_legalize_ar
LEGALIZE_API_BASE_URL=https://legalize.dev
LEGALIZE_API_KEY=
LEGALIZE_API_MONTHLY_LIMIT=2000
PINECONE_LEGAL_NAMESPACE=ar-legislation
RAG_TOP_K=8

# === Observabilidad & Metricas ===
# En Docker Compose (o contenedor en red compartida): http://phoenix:6006/v1/traces
# Corriendo local nativo en la máquina sin Docker: http://localhost:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_PROJECT_NAME=intelligence-system
PHOENIX_ENABLED=true
PROMETHEUS_METRICS_ENABLED=true

# === Seguridad / autenticacion ===
API_KEY_HEADER_NAME=X-API-Key
# Pepper de aplicacion (nunca en la DB): generar con `openssl rand -hex 32`
API_KEY_PEPPER=
# Primera API key admin, se siembra en el primer `python -m scripts.init_db`
# si la tabla api_keys esta vacia. Elegila vos (ej. `openssl rand -base64 32`)
# y usala tal cual en el header X-API-Key -- despues crear mas keys por
# POST /api/v1/admin/api-keys y considera revocar/rotar esta.
BOOTSTRAP_ADMIN_API_KEY=

# === Rate limiting ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS_PER_MINUTE=20
RATE_LIMIT_CLIENT_PER_MINUTE=60
RATE_LIMIT_CLIENT_CHAT_PER_MINUTE=15
RATE_LIMIT_ADMIN_PER_MINUTE=120

# === Proxy / IP ===
# IPs/CIDR desde donde se confía en el header X-Forwarded-For (default: solo
# el propio host, igual que el default de uvicorn). Agregar proxy si se corre detrás de Traefik/Nginx.
TRUSTED_PROXY_IPS=127.0.0.1
# CIDR separados por coma que pueden usar keys admin (ej. VPN o red de administradores).
# Vacío = deshabilitado (cualquier IP autenticada como admin entra).
ADMIN_IP_ALLOWLIST=

# === Retrieval hibrido (Postgres FTS + vectorial Pinecone) ===
HYBRID_RETRIEVAL_ENABLED=true
LEXICAL_WEIGHT=0.4
VECTOR_WEIGHT=0.6
HYBRID_CANDIDATE_MULTIPLIER=3

# === Evaluacion RAG (LLM-as-judge, scripts/evaluate_rag.py) ===
EVALUATION_PASS_THRESHOLD=0.7

